@prefix schema: <http://schema.org/> .

<{{ account.dataset_uri }}entity/organization/example> a schema:Organization ;
    schema:logo <{{ account.dataset_uri }}entity/organization/example/logo> ;
    schema:name "Herkes Için Güzellik" ;
    schema:sameAs <https://facebook.com/examplecom>,
        <https://instagram.com/examplecom>,
        <https://www.tiktok.com/@examplecom> ;
