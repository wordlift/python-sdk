<https://wordlift.io/shacl/google/merchant-listing/shippingrate-currency-mismatch> a sh:NodeShape ;
    sh:message "the MonetaryAmount under an OfferShippingDetails' shippingRate for an OfferShippingDetails nested under an Offer must have the same currency as that Offer's priceCurrency (checked only when both exist)." ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "the MonetaryAmount under an OfferShippingDetails' shippingRate for an OfferShippingDetails nested under an Offer must have the same currency as that Offer's priceCurrency (checked only when both exist)." ;
            sh:select "SELECT $this ?value WHERE { $this <http://schema.org/currency> ?value . ?osd <http://schema.org/shippingRate> $this . ?offer <http://schema.org/shippingDetails> ?osd . ?offer <http://schema.org/priceCurrency> ?offerCurrency . FILTER NOT EXISTS { ?offer a <http://schema.org/AggregateOffer> } FILTER (?offerCurrency != ?value) }" ] ;
    sh:targetObjectsOf schema:shippingRate .

<https://wordlift.io/shacl/google/merchant-listing/shippingrate-currency-missing> a sh:NodeShape ;
    sh:message "the MonetaryAmount under an OfferShippingDetails' shippingRate must have currency." ;
    sh:or ( [ sh:property [ sh:node [ sh:or ( [ sh:property [ sh:minCount 1 ;
                                                    sh:path schema:currency ] ] ) ] ;
                        sh:path schema:shippingRate ] ] ) ;
    sh:targetClass schema:OfferShippingDetails .

<https://wordlift.io/shacl/google/merchant-listing/shippingrate-value-missing> a sh:NodeShape ;
    sh:message "the MonetaryAmount under an OfferShippingDetails' shippingRate must have value or maxValue." ;
    sh:or ( [ sh:property [ sh:node [ sh:or ( [ sh:property [ sh:minCount 1 ;
                                                    sh:path schema:value ] ] [ sh:property [ sh:minCount 1 ;
                                                    sh:path schema:maxValue ] ] ) ] ;
                        sh:path schema:shippingRate ] ] ) ;
    sh:targetClass schema:OfferShippingDetails .

<https://wordlift.io/shacl/google/merchant-listing/shippingtime-maxvalue-invalid> a sh:NodeShape ;
    sh:message "The maxValue of the QuantitativeValue under a ShippingDeliveryTime's handlingTime or transitTime must be a non-negative whole number." ;
    sh:or ( [ sh:property [ sh:node [ sh:or ( [ sh:property [ sh:path schema:maxValue ;
                                                    sh:pattern "^[0-9]+$" ] ] ) ] ;
                        sh:path [ sh:alternativePath ( schema:handlingTime schema:transitTime ) ] ] ] ) ;
    sh:targetClass schema:ShippingDeliveryTime .

<https://wordlift.io/shacl/google/merchant-listing/shippingtime-maxvalue-missing> a sh:NodeShape ;
    sh:message "the QuantitativeValue under a ShippingDeliveryTime's handlingTime or transitTime must have maxValue." ;
    sh:or ( [ sh:property [ sh:node [ sh:or ( [ sh:property [ sh:minCount 1 ;
                                                    sh:path schema:maxValue ] ] ) ] ;
                        sh:path [ sh:alternativePath ( schema:handlingTime schema:transitTime ) ] ] ] ) ;
    sh:targetClass schema:ShippingDeliveryTime .

<https://wordlift.io/shacl/google/merchant-listing/shippingtime-minvalue-invalid> a sh:NodeShape ;
    sh:message "The minValue of the QuantitativeValue under a ShippingDeliveryTime's handlingTime or transitTime must be a non-negative whole number." ;
    sh:or ( [ sh:property [ sh:node [ sh:or ( [ sh:property [ sh:path schema:minValue ;
                                                    sh:pattern "^[0-9]+$" ] ] ) ] ;
                        sh:path [ sh:alternativePath ( schema:handlingTime schema:transitTime ) ] ] ] ) ;
    sh:targetClass schema:ShippingDeliveryTime .

<https://wordlift.io/shacl/google/merchant-listing/shippingtime-minvalue-missing> a sh:NodeShape ;
    sh:message "the QuantitativeValue under a ShippingDeliveryTime's handlingTime or transitTime must have minValue." ;
    sh:or ( [ sh:property [ sh:node [ sh:or ( [ sh:property [ sh:minCount 1 ;
                                                    sh:path schema:minValue ] ] ) ] ;
                        sh:path [ sh:alternativePath ( schema:handlingTime schema:transitTime ) ] ] ] ) ;
    sh:targetClass schema:ShippingDeliveryTime .

<https://wordlift.io/shacl/google/merchant-listing/shippingtime-unitcode-missing> a sh:NodeShape ;
    sh:message "the QuantitativeValue under a ShippingDeliveryTime's handlingTime or transitTime must have unitCode." ;
    sh:or ( [ sh:property [ sh:node [ sh:or ( [ sh:property [ sh:minCount 1 ;
                                                    sh:path schema:unitCode ] ] ) ] ;
                        sh:path [ sh:alternativePath ( schema:handlingTime schema:transitTime ) ] ] ] ) ;
    sh:targetClass schema:ShippingDeliveryTime .

<https://wordlift.io/shacl/google/merchant-listing/shippingtime-unitcode-value> a sh:NodeShape ;
    sh:message "The unitCode of the QuantitativeValue under a ShippingDeliveryTime's handlingTime or transitTime must be DAY or d." ;
    sh:or ( [ sh:property [ sh:node [ sh:or ( [ sh:property [ sh:in ( "DAY" "d" ) ;
                                                    sh:path schema:unitCode ] ] ) ] ;
                        sh:path [ sh:alternativePath ( schema:handlingTime schema:transitTime ) ] ] ] ) ;
    sh:targetClass schema:ShippingDeliveryTime .

<https://wordlift.io/shacl/google/merchant-listing/sizespecification-name-missing> a sh:NodeShape ;
    sh:message "Every SizeSpecification should have name." ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path schema:name ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetClass schema:SizeSpecification .

<https://wordlift.io/shacl/google/merchant-listing/sizespecification-sizegroup-missing> a sh:NodeShape ;
