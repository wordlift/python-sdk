<https://wordlift.io/shacl/google/merchant-listing/unitpricespecification-price-missing> a sh:NodeShape ;
    sh:message "the UnitPriceSpecification under such an Offer's priceSpecification must have price, unless it has membershipPointsEarned." ;
    sh:or ( [ sh:class schema:ProductGroup ] [ sh:property [ sh:node [ sh:or ( [ sh:class schema:AggregateOffer ] [ sh:property [ sh:node [ sh:or ( [ sh:not [ sh:class schema:UnitPriceSpecification ] ] [ sh:property [ sh:minCount 1 ;
                                                                                sh:path schema:price ] ] [ sh:property [ sh:minCount 1 ;
