<https://wordlift.io/shacl/google/merchant-listing/certification-identification-or-rating-missing> a sh:NodeShape ;
    sh:message "Every Certification should have certificationIdentification or certificationRating." ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path [ sh:alternativePath ( schema:certificationIdentification schema:certificationRating ) ] ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetClass schema:Certification .

<https://wordlift.io/shacl/google/merchant-listing/certification-issuedby-missing> a sh:NodeShape ;
    sh:message "Every Certification must have issuedBy." ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path schema:issuedBy ] ] ) ;
    sh:targetClass schema:Certification .

<https://wordlift.io/shacl/google/merchant-listing/certification-issuedby-name-value> a sh:NodeShape ;
    sh:message "A Certification's issuedBy must have a name of EC, European_Commission, ADEME or BMWK." ;
    sh:or ( [ sh:property [ sh:in ( "EC" "European_Commission" "ADEME" "BMWK" ) ;
                        sh:path ( schema:issuedBy schema:name ) ] ] ) ;
    sh:targetClass schema:Certification .

<https://wordlift.io/shacl/google/merchant-listing/certification-name-missing> a sh:NodeShape ;
    sh:message "Every Certification must have name." ;
