<https://wordlift.io/shacl/google/merchant-listing/peopleaudience-suggestedgender-missing> a sh:NodeShape ;
    sh:message "Every PeopleAudience should have suggestedGender." ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path schema:suggestedGender ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetClass schema:MedicalAudience,
        schema:ParentAudience,
        schema:Patient,
        schema:PeopleAudience .

<https://wordlift.io/shacl/google/merchant-listing/peopleaudience-suggestedgender-value> a sh:NodeShape ;
    sh:message "Every suggestedGender of a PeopleAudience must be https://schema.org/Male, https://schema.org/Female, or male, female, unisex (case-insensitive)." ;
    sh:or ( [ sh:property [ sh:or ( [ sh:in ( schema:Male <https://schema.org/Male> "http://schema.org/Male" "https://schema.org/Male" schema:Female <https://schema.org/Female> "http://schema.org/Female" "https://schema.org/Female" ) ] [ sh:flags "i" ;
                                    sh:pattern "^(male|female|unisex)$" ] ) ;
                        sh:path schema:suggestedGender ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetClass schema:MedicalAudience,
        schema:ParentAudience,
        schema:Patient,
        schema:PeopleAudience .

<https://wordlift.io/shacl/google/merchant-listing/peopleaudience-suggestedmaxage-missing> a sh:NodeShape ;
    sh:message "Every PeopleAudience should have suggestedMaxAge (or suggestedAge.maxValue), unless its minimum age is 13 or more (adults)." ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path [ sh:alternativePath ( schema:suggestedMaxAge ( schema:suggestedAge schema:maxValue ) ) ] ] ] [ sh:property [ sh:minCount 1 ;
                        sh:or ( [ sh:minInclusive 13 ] [ sh:pattern "^ *(1[3-9]|[2-9][0-9]|[0-9]{3,})(\\.[0-9]+)? *$" ] ) ;
                        sh:path [ sh:alternativePath ( schema:suggestedMinAge ( schema:suggestedAge schema:minValue ) ) ] ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetClass schema:MedicalAudience,
        schema:ParentAudience,
        schema:Patient,
        schema:PeopleAudience .

<https://wordlift.io/shacl/google/merchant-listing/peopleaudience-suggestedminage-missing> a sh:NodeShape ;
    sh:message "Every PeopleAudience should have suggestedMinAge (or suggestedAge.minValue)." ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path [ sh:alternativePath ( schema:suggestedMinAge ( schema:suggestedAge schema:minValue ) ) ] ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetClass schema:MedicalAudience,
        schema:ParentAudience,
        schema:Patient,
        schema:PeopleAudience .

