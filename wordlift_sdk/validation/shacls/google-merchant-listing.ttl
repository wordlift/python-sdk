    sh:targetClass schema:Certification .

<https://wordlift.io/shacl/google/merchant-listing/certification-name-value> a sh:NodeShape ;
    sh:message "A Certification's name must be EPREL, Vehicle_CO2_Class or Vehicle_CO2_Class_Discharged_Battery." ;
    sh:or ( [ sh:property [ sh:in ( "EPREL" "Vehicle_CO2_Class" "Vehicle_CO2_Class_Discharged_Battery" ) ;
                        sh:path schema:name ] ] ) ;
    sh:targetClass schema:Certification .

