<https://wordlift.io/shacl/google/merchant-listing/definedregion-addressregion-format> a sh:NodeShape ;
    sh:message "Every addressRegion of the DefinedRegion under an OfferShippingDetails' shippingDestination must be 2 or 3 alphanumeric characters (no country prefix)." ;
