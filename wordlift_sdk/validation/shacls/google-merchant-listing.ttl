<https://wordlift.io/shacl/google/merchant-listing/unitpricespecification-price-nonpositive> a sh:NodeShape ;
    sh:message "The active the UnitPriceSpecification under such an Offer's priceSpecification (no priceType, no validForMemberTier) must have price greater than zero." ;
    sh:or ( [ sh:class schema:ProductGroup ] [ sh:property [ sh:node [ sh:or ( [ sh:class schema:AggregateOffer ] [ sh:property [ sh:node [ sh:or ( [ sh:not [ sh:class schema:UnitPriceSpecification ] ] [ sh:property [ sh:minCount 1 ;
