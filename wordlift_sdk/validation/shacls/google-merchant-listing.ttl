<https://wordlift.io/shacl/google/merchant-listing/3dmodel-encoding-contenturl-missing> a sh:NodeShape ;
    sh:message "Every MediaObject under a 3DModel's encoding must have contentUrl." ;
    sh:or ( [ sh:property [ sh:node [ sh:or ( [ sh:property [ sh:minCount 1 ;
                                                    sh:path schema:contentUrl ] ] ) ] ;
                        sh:path schema:encoding ] ] ) ;
    sh:targetClass schema:3DModel .

<https://wordlift.io/shacl/google/merchant-listing/3dmodel-encoding-contenturl-suffix> a sh:NodeShape ;
    sh:message "The contentUrl of a 3DModel's encoding must end in .gltf or .glb (query and fragment ignored, case-insensitive)." ;
    sh:or ( [ sh:property [ sh:node [ sh:or ( [ sh:property [ sh:flags "i" ;
                                                    sh:path schema:contentUrl ;
                                                    sh:pattern "^[^?#]*\\.(gltf|glb)([?#].*)?$" ] ] ) ] ;
                        sh:path schema:encoding ] ] ) ;
    sh:targetClass schema:3DModel .

<https://wordlift.io/shacl/google/merchant-listing/3dmodel-encoding-missing> a sh:NodeShape ;
    sh:message "Every 3DModel must have encoding." ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path schema:encoding ] ] ) ;
    sh:targetClass schema:3DModel .

<https://wordlift.io/shacl/google/merchant-listing/categorycode-codevalue-missing> a sh:NodeShape ;
    sh:message "A CategoryCode under a checked Product's category must have codeValue." ;
    sh:or ( [ sh:class schema:ProductGroup ] [ sh:property [ sh:node [ sh:or ( [ sh:not [ sh:or ( [ sh:class schema:CategoryCode ] [ sh:class schema:MedicalCode ] ) ] ] [ sh:property [ sh:minCount 1 ;
                                                    sh:path schema:codeValue ] ] ) ] ;
                        sh:path schema:category ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetClass schema:BusOrCoach,
        schema:Car,
        schema:DietarySupplement,
        schema:Drug,
        schema:IndividualProduct,
        schema:Motorcycle,
        schema:MotorizedBicycle,
        schema:Product,
        schema:ProductCollection,
        schema:ProductGroup,
        schema:ProductModel,
        schema:SomeProducts,
        schema:Vehicle .

<https://wordlift.io/shacl/google/merchant-listing/categorycode-codevalue-segment-letterless> a sh:NodeShape ;
    sh:message "A CategoryCode under a checked Product's category whose codeValue uses the path format (contains >) must have at least one letter in every segment; numeric IDs without > are accepted." ;
    sh:or ( [ sh:class schema:ProductGroup ] [ sh:property [ sh:node [ sh:or ( [ sh:not [ sh:or ( [ sh:class schema:CategoryCode ] [ sh:class schema:MedicalCode ] ) ] ] [ sh:property [ sh:path schema:codeValue ;
                                                    sh:pattern "^(?:[^>]*|[^>]*[^\\W\\d_][^>]*(?:>[^>]*[^\\W\\d_][^>]*)+)$" ] ] ) ] ;
                        sh:path schema:category ] ] [ sh:property [ sh:maxCount 0 ;
                        sh:path schema:offers ] ] ) ;
