                                                                        sh:ignoredProperties ( rdf:type ) ] [ sh:property [ sh:not [ sh:in ( schema:ReturnShippingFees <https://schema.org/ReturnShippingFees> "http://schema.org/ReturnShippingFees" "https://schema.org/ReturnShippingFees" ) ] ;
                                                                                sh:path schema:returnFees ] ] [ sh:property [ sh:not [ sh:or ( [ sh:maxInclusive 0 ;
                                                                                                    sh:minInclusive 0 ] [ sh:pattern "^ *0*(\\.0*)? *$" ] ) ] ;
                                                                                sh:path ( schema:returnShippingFeesAmount schema:value ) ] ] ) ] ;
                                                    sh:path schema:hasMerchantReturnPolicy ] ] ) ] ;
                        sh:path schema:offers ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetClass schema:BusOrCoach,
        schema:Car,
        schema:DietarySupplement,
        schema:Drug,
        schema:IndividualProduct,
        schema:Motorcycle,
        schema:MotorizedBicycle,
        schema:Product,
        schema:ProductCollection,
        schema:ProductGroup,
        schema:ProductModel,
        schema:SomeProducts,
        schema:Vehicle .

