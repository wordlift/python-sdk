    sh:targetClass schema:SizeSpecification .

<https://wordlift.io/shacl/google/merchant-listing/unitpricespecification-membershippointsearned-missing> a sh:NodeShape ;
    sh:message "the UnitPriceSpecification under such an Offer's priceSpecification that has validForMemberTier should have membershipPointsEarned." ;
    sh:or ( [ sh:class schema:ProductGroup ] [ sh:property [ sh:node [ sh:or ( [ sh:class schema:AggregateOffer ] [ sh:property [ sh:node [ sh:or ( [ sh:not [ sh:class schema:UnitPriceSpecification ] ] [ sh:property [ sh:maxCount 0 ;
                                                                                sh:path schema:validForMemberTier ] ] [ sh:property [ sh:minCount 1 ;
                                                                                sh:path schema:membershipPointsEarned ] ] ) ] ;
