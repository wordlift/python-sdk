    sh:targetClass schema:SizeSpecification .

<https://wordlift.io/shacl/google/merchant-listing/sizespecification-sizegroup-too-many> a sh:NodeShape ;
    sh:message "Every SizeSpecification must have at most two sizeGroup values." ;
    sh:or ( [ sh:property [ sh:maxCount 2 ;
                        sh:path schema:sizeGroup ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetClass schema:SizeSpecification .

<https://wordlift.io/shacl/google/merchant-listing/sizespecification-sizesystem-missing> a sh:NodeShape ;
    sh:message "Every SizeSpecification should have sizeSystem." ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
