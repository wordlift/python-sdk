@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://wordlift.io/shacl/google/software-app/offer-pricecurrency-recommended-when-price-positive> a sh:NodeShape ;
    sh:property [ sh:message "software-app rule offer-pricecurrency-recommended-when-price-positive: an Offer with a price greater than 0 should have priceCurrency." ;
            sh:path schema:offers ;
            sh:qualifiedMaxCount 0 ;
            sh:qualifiedValueShape [ sh:property [ sh:path schema:price ;
                            sh:qualifiedMinCount 1 ;
                            sh:qualifiedValueShape [ sh:or ( [ sh:minExclusive 0 ] [ sh:pattern "^\\+?(0*[1-9][0-9]*(\\.[0-9]*)?|0*\\.[0-9]*[1-9][0-9]*)$" ] ) ] ],
                        [ sh:maxCount 0 ;
                            sh:path schema:priceCurrency ] ] ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:MobileApplication,
        schema:OperatingSystem,
        schema:RuntimePlatform,
        schema:SoftwareApplication,
        schema:VideoGame,
        schema:WebApplication .

<https://wordlift.io/shacl/google/software-app/softwareapplication-applicationcategory-recommended> a sh:NodeShape ;
    sh:property [ sh:message "software-app rule softwareapplication-applicationcategory-recommended: a SoftwareApplication should have applicationCategory." ;
            sh:minCount 1 ;
            sh:path schema:applicationCategory ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:MobileApplication,
        schema:OperatingSystem,
        schema:RuntimePlatform,
        schema:SoftwareApplication,
        schema:VideoGame,
        schema:WebApplication .

<https://wordlift.io/shacl/google/software-app/softwareapplication-applicationcategory-supported-value> a sh:NodeShape ;
    sh:property [ sh:in ( "GameApplication" "SocialNetworkingApplication" "TravelApplication" "ShoppingApplication" "SportsApplication" "LifestyleApplication" "BusinessApplication" "DesignApplication" "DeveloperApplication" "DriverApplication" "EducationalApplication" "HealthApplication" "FinanceApplication" "SecurityApplication" "BrowserApplication" "CommunicationApplication" "DesktopEnhancementApplication" "EntertainmentApplication" "MultimediaApplication" "HomeApplication" "UtilitiesApplication" ) ;
            sh:message "software-app rule softwareapplication-applicationcategory-supported-value: each applicationCategory must be one of the supported app types (exact text, e.g. GameApplication)." ;
            sh:path schema:applicationCategory ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:MobileApplication,
        schema:OperatingSystem,
        schema:RuntimePlatform,
        schema:SoftwareApplication,
        schema:VideoGame,
        schema:WebApplication .

<https://wordlift.io/shacl/google/software-app/softwareapplication-name-required> a sh:NodeShape ;
    sh:property [ sh:message "software-app rule softwareapplication-name-required: a SoftwareApplication must have a name." ;
            sh:minCount 1 ;
            sh:path schema:name ] ;
    sh:targetClass schema:MobileApplication,
