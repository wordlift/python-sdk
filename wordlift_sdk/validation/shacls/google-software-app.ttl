<https://wordlift.io/shacl/google/software-app/softwareapplication-rating-or-review-required> a sh:NodeShape ;
    sh:message "software-app rule softwareapplication-rating-or-review-required: a SoftwareApplication must have aggregateRating or review." ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path schema:aggregateRating ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:review ] ] ) ;
    sh:targetClass schema:MobileApplication,
        schema:OperatingSystem,
        schema:RuntimePlatform,
        schema:SoftwareApplication,
        schema:VideoGame,
        schema:WebApplication .

<https://wordlift.io/shacl/google/software-app/softwareapplication-videogame-needs-cotype> a sh:NodeShape ;
    sh:property [ sh:message "software-app rule softwareapplication-videogame-needs-cotype: a VideoGame SoftwareApplication is not rich-result eligible unless co-typed (e.g. MobileApplication or WebApplication)." ;
            sh:path rdf:type ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:in ( schema:MobileApplication schema:WebApplication ) ] ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:VideoGame .

