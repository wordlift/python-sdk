        schema:SoftwareApplication,
        schema:VideoGame,
        schema:WebApplication .

<https://wordlift.io/shacl/google/software-app/softwareapplication-offers-price-required> a sh:NodeShape ;
    sh:property [ sh:message "software-app rule softwareapplication-offers-price-required: a SoftwareApplication must have an Offer in offers with a price (0 counts as present)." ;
            sh:path schema:offers ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:or ( [ sh:class schema:Offer ] [ sh:class schema:AggregateOffer ] [ sh:class schema:OfferForLease ] [ sh:class schema:OfferForPurchase ] ) ;
                    sh:property [ sh:minCount 1 ;
                            sh:path schema:price ] ] ] ;
    sh:targetClass schema:MobileApplication,
        schema:OperatingSystem,
        schema:RuntimePlatform,
        schema:SoftwareApplication,
        schema:VideoGame,
        schema:WebApplication .

<https://wordlift.io/shacl/google/software-app/softwareapplication-operatingsystem-recommended> a sh:NodeShape ;
    sh:property [ sh:message "software-app rule softwareapplication-operatingsystem-recommended: a SoftwareApplication should have operatingSystem." ;
