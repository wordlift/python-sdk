@prefix : <https://wordlift.io/shacl/google/google-return-policy/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix schema: <http://schema.org/> .

# Source: https://developers.google.com/search/docs/appearance/structured-data/return-policy
# Generated: 2026-02-06T07:25:19Z
# Notes: required properties => errors; recommended properties => warnings.

:google_MerchantReturnEnumerationShape
  a sh:NodeShape ;
  sh:targetClass schema:MerchantReturnEnumeration ;
  sh:or (
    [
      sh:property [
        sh:path schema:https ;
        sh:minCount 1 ;
      ] ;
    ]
    [
      sh:property [
        sh:path ( schema:schema schema:org ) ;
        sh:minCount 1 ;
      ] ;
    ]
  ) ;
.

