<https://wordlift.io/shacl/google/organization/contactpoint-email-present/contact> a sh:NodeShape ;
    sh:or ( [ sh:not [ sh:or ( [ sh:class schema:ContactPoint ] [ sh:class schema:PostalAddress ] ) ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:email ] ] ) .

<https://wordlift.io/shacl/google/organization/contactpoint-telephone-present/contact> a sh:NodeShape ;
    sh:or ( [ sh:not [ sh:or ( [ sh:class schema:ContactPoint ] [ sh:class schema:PostalAddress ] ) ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:telephone ] ] ) .

<https://wordlift.io/shacl/google/organization/imageobject-contenturl-or-url-present/image> a sh:NodeShape ;
    sh:or ( [ sh:not [ sh:or ( [ sh:class schema:ImageObject ] [ sh:class schema:Barcode ] [ sh:class schema:ImageObjectSnapshot ] ) ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:contentUrl ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:url ] ] ) .

<https://wordlift.io/shacl/google/organization/postaladdress-addresscountry-present/postal> a sh:NodeShape ;
    sh:or ( [ sh:not [ sh:class schema:PostalAddress ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:addressCountry ] ] ) .

<https://wordlift.io/shacl/google/organization/postaladdress-addresslocality-present/postal> a sh:NodeShape ;
    sh:or ( [ sh:not [ sh:class schema:PostalAddress ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:addressLocality ] ] ) .

<https://wordlift.io/shacl/google/organization/postaladdress-addressregion-present/postal> a sh:NodeShape ;
    sh:or ( [ sh:not [ sh:class schema:PostalAddress ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:addressRegion ] ] ) .

<https://wordlift.io/shacl/google/organization/postaladdress-postalcode-present/postal> a sh:NodeShape ;
    sh:or ( [ sh:not [ sh:class schema:PostalAddress ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:postalCode ] ] ) .

<https://wordlift.io/shacl/google/organization/postaladdress-streetaddress-present/postal> a sh:NodeShape ;
    sh:or ( [ sh:not [ sh:class schema:PostalAddress ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:streetAddress ] ] ) .

