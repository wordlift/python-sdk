@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://wordlift.io/shacl/google/course/course-description-required> a sh:NodeShape ;
    sh:property [ sh:message "Google course rule: every Course, including nested ones, must have a description (course-description-required)." ;
            sh:minCount 1 ;
            sh:path schema:description ] ;
    sh:targetClass schema:Course .

<https://wordlift.io/shacl/google/course/course-name-required> a sh:NodeShape ;
    sh:property [ sh:message "Google course rule: every Course, including nested ones, must have a name (course-name-required)." ;
            sh:minCount 1 ;
            sh:path schema:name ] ;
    sh:targetClass schema:Course .

<https://wordlift.io/shacl/google/course/course-provider-recommended> a sh:NodeShape ;
    sh:property [ sh:message "Google course rule: a Course should have a provider (course-provider-recommended)." ;
            sh:minCount 1 ;
            sh:path schema:provider ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:Course .

<https://wordlift.io/shacl/google/course/itemlist-itemlistelement-required> a sh:NodeShape ;
    sh:message "Google course rule: an ItemList of courses must have an itemListElement (itemlist-itemlistelement-required)." ;
    sh:or ( [ sh:class schema:BreadcrumbList ] [ sh:class schema:HowToSection ] [ sh:class schema:HowToStep ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:itemListElement ] ] ) ;
    sh:targetClass schema:BreadcrumbList,
        schema:HowToSection,
        schema:HowToStep,
        schema:ItemList,
        schema:OfferCatalog .

<https://wordlift.io/shacl/google/course/listitem-position-required> a sh:NodeShape ;
    sh:message "Google course rule: each ListItem of a course list must have a position (listitem-position-required)." ;
    sh:or ( [ sh:class schema:BreadcrumbList ] [ sh:class schema:HowToSection ] [ sh:class schema:HowToStep ] [ sh:not [ sh:property [ sh:path ( schema:itemListElement schema:item ) ;
                                sh:qualifiedMinCount 1 ;
                                sh:qualifiedValueShape [ sh:class schema:Course ] ] ] ] [ sh:property [ sh:node [ sh:property [ sh:message "Google course rule: each ListItem of a course list must have a position (listitem-position-required)." ;
                                        sh:minCount 1 ;
                                        sh:path schema:position ] ] ;
                        sh:path schema:itemListElement ] ] ) ;
    sh:targetClass schema:BreadcrumbList,
        schema:HowToSection,
        schema:HowToStep,
        schema:ItemList,
        schema:OfferCatalog .

<https://wordlift.io/shacl/google/course/listitem-url-required> a sh:NodeShape ;
    sh:message "Google course rule: each ListItem of a course list must have a URL (listitem-url-required)." ;
    sh:or ( [ sh:class schema:BreadcrumbList ] [ sh:class schema:HowToSection ] [ sh:class schema:HowToStep ] [ sh:not [ sh:property [ sh:path ( schema:itemListElement schema:item ) ;
                                sh:qualifiedMinCount 1 ;
                                sh:qualifiedValueShape [ sh:class schema:Course ] ] ] ] [ sh:property [ sh:node [ sh:message "Google course rule: each ListItem of a course list must have a URL (listitem-url-required)." ;
                                sh:or ( [ sh:property [ sh:minCount 1 ;
                                                    sh:path schema:url ] ] [ sh:property [ sh:minCount 1 ;
                                                    sh:path ( schema:item schema:url ) ] ] [ sh:property [ sh:minCount 1 ;
                                                    sh:nodeKind sh:Literal ;
                                                    sh:path schema:item ] ] ) ] ;
                        sh:path schema:itemListElement ] ] ) ;
    sh:targetClass schema:BreadcrumbList,
        schema:HowToSection,
        schema:HowToStep,
        schema:ItemList,
        schema:OfferCatalog .

<https://wordlift.io/shacl/google/course/listitem-url-unique> a sh:NodeShape ;
    sh:message "Google course rule: the URLs of the ListItems in a course list must be unique (listitem-url-unique)." ;
    sh:or ( [ sh:class schema:BreadcrumbList ] [ sh:class schema:HowToSection ] [ sh:class schema:HowToStep ] [ sh:not [ sh:property [ sh:path ( schema:itemListElement schema:item ) ;
                                sh:qualifiedMinCount 1 ;
                                sh:qualifiedValueShape [ sh:class schema:Course ] ] ] ] [ sh:sparql [ sh:message "Google course rule: the URLs of the ListItems in a course list must be unique (listitem-url-unique)." ;
                        sh:select """
                SELECT $this ?a
                WHERE {
                    $this <http://schema.org/itemListElement> ?a , ?b .
                    FILTER (?a != ?b)
                    ?a (<http://schema.org/url>|<http://schema.org/item>/<http://schema.org/url>) ?u .
                    ?b (<http://schema.org/url>|<http://schema.org/item>/<http://schema.org/url>) ?u .
                }
                """ ] ] ) ;
    sh:targetClass schema:BreadcrumbList,
        schema:HowToSection,
        schema:HowToStep,
        schema:ItemList,
        schema:OfferCatalog .

