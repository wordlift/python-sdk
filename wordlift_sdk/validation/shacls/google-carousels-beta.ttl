:google_EventShape
  a sh:NodeShape ;
  sh:targetClass schema:Event ;
  sh:property [
    sh:path schema:image ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path schema:name ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path schema:url ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path ( schema:aggregateRating schema:bestRating ) ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "Recommended by Google: aggregateRating.bestRating." ;
  ] ;
  sh:property [
    sh:path ( schema:aggregateRating schema:ratingCount ) ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "Recommended by Google: aggregateRating.ratingCount." ;
  ] ;
  sh:property [
    sh:path ( schema:aggregateRating schema:ratingValue ) ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "Recommended by Google: aggregateRating.ratingValue." ;
  ] ;
  sh:property [
    sh:path schema:offers ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "Recommended by Google: offers." ;
  ] ;
  sh:property [
    sh:path ( schema:offers schema:highPrice ) ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "Recommended by Google: offers.highPrice." ;
  ] ;
  sh:property [
    sh:path ( schema:offers schema:lowPrice ) ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "Recommended by Google: offers.lowPrice." ;
  ] ;
  sh:property [
    sh:path ( schema:offers schema:price ) ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "Recommended by Google: offers.price." ;
  ] ;
  sh:property [
    sh:path ( schema:offers schema:priceCurrency ) ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "Recommended by Google: offers.priceCurrency." ;
  ] ;
.

