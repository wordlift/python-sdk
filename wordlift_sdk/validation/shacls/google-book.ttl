    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path [ sh:inversePath schema:lender ] ] ] [ sh:property [ sh:node [ sh:or ( [ sh:not [ sh:property [ sh:hasValue "librarytype" ;
                                                            sh:path schema:name ] ] ] [ sh:property [ sh:in ( "public" "academic" "corporate" "government" "school" "special" ) ;
                                                    sh:minCount 1 ;
                                                    sh:path schema:value ] ] ) ] ;
                        sh:path schema:additionalProperty ] ] ) ;
    sh:targetClass schema:LibrarySystem .

<https://wordlift.io/shacl/google/book/librarysystem-member-present> a sh:NodeShape ;
    sh:message "Every LibrarySystem has at least one member that is a Library (on LibrarySystem nodes (except a LibrarySystem used as the lender of a BorrowAction, which is only a reference))." ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path [ sh:inversePath schema:lender ] ] ] [ sh:property [ sh:path schema:member ;
                        sh:qualifiedMinCount 1 ;
                        sh:qualifiedValueShape [ sh:class schema:Library ] ] ] ) ;
    sh:targetClass schema:LibrarySystem .

<https://wordlift.io/shacl/google/book/librarysystem-name-present> a sh:NodeShape ;
    sh:message "Every LibrarySystem has a name (on LibrarySystem nodes (except a LibrarySystem used as the lender of a BorrowAction, which is only a reference))." ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path [ sh:inversePath schema:lender ] ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:name ] ] ) ;
    sh:targetClass schema:LibrarySystem .

<https://wordlift.io/shacl/google/book/librarysystem-url-present> a sh:NodeShape ;
    sh:message "Every LibrarySystem has a url (on LibrarySystem nodes (except a LibrarySystem used as the lender of a BorrowAction, which is only a reference))." ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path [ sh:inversePath schema:lender ] ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:url ] ] ) ;
    sh:targetClass schema:LibrarySystem .

<https://wordlift.io/shacl/google/book/readaction-country-name-present> a sh:NodeShape ;
    sh:message "Every Country under eligibleRegion has a name (on the Offer under the expectsAcceptanceOf of a ReadAction under an Edition's potentialAction)." ;
    sh:or ( [ sh:not [ sh:property [ sh:minCount 1 ;
                                sh:path ( [ sh:inversePath schema:expectsAcceptanceOf ] [ sh:inversePath schema:potentialAction ] [ sh:inversePath schema:workExample ] ) ] ] ] [ sh:property [ sh:node [ sh:or ( [ sh:not [ sh:class schema:Country ] ] [ sh:property [ sh:minCount 1 ;
                                                    sh:path schema:name ] ] ) ] ;
                        sh:path schema:eligibleRegion ] ] ) ;
    sh:targetObjectsOf schema:expectsAcceptanceOf .

<https://wordlift.io/shacl/google/book/readaction-eligibleregion-type-country> a sh:NodeShape ;
    sh:message "Every eligibleRegion value is a Country node (on the Offer under the expectsAcceptanceOf of a ReadAction under an Edition's potentialAction)." ;
    sh:or ( [ sh:not [ sh:property [ sh:minCount 1 ;
                                sh:path ( [ sh:inversePath schema:expectsAcceptanceOf ] [ sh:inversePath schema:potentialAction ] [ sh:inversePath schema:workExample ] ) ] ] ] [ sh:property [ sh:class schema:Country ;
                        sh:path schema:eligibleRegion ] ] ) ;
    sh:targetObjectsOf schema:expectsAcceptanceOf .

<https://wordlift.io/shacl/google/book/readaction-expectsacceptanceof-present> a sh:NodeShape ;
    sh:message "Every ReadAction has an expectsAcceptanceOf (on the ReadAction under an Edition's potentialAction)." ;
    sh:or ( [ sh:not [ sh:property [ sh:minCount 1 ;
                                sh:path ( [ sh:inversePath schema:potentialAction ] [ sh:inversePath schema:workExample ] ) ] ] ] [ sh:not [ sh:class schema:ReadAction ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:expectsAcceptanceOf ] ] ) ;
    sh:targetObjectsOf schema:potentialAction .

<https://wordlift.io/shacl/google/book/readaction-offer-availabilityends-present> a sh:NodeShape ;
    sh:message "Every Offer has an availabilityEnds (on the Offer under the expectsAcceptanceOf of a ReadAction under an Edition's potentialAction)." ;
    sh:property [ sh:path ( schema:potentialAction schema:expectsAcceptanceOf ) ;
            sh:qualifiedMaxCount 0 ;
            sh:qualifiedValueShape [ sh:not [ sh:property [ sh:minCount 1 ;
                                    sh:path schema:availabilityEnds ] ] ] ;
            sh:severity sh:Warning ] ;
    sh:targetObjectsOf schema:workExample .

<https://wordlift.io/shacl/google/book/readaction-offer-availabilitystarts-present> a sh:NodeShape ;
    sh:message "Every Offer has an availabilityStarts (on the Offer under the expectsAcceptanceOf of a ReadAction under an Edition's potentialAction)." ;
    sh:property [ sh:path ( schema:potentialAction schema:expectsAcceptanceOf ) ;
            sh:qualifiedMaxCount 0 ;
            sh:qualifiedValueShape [ sh:not [ sh:property [ sh:minCount 1 ;
                                    sh:path schema:availabilityStarts ] ] ] ;
            sh:severity sh:Warning ] ;
    sh:targetObjectsOf schema:workExample .

<https://wordlift.io/shacl/google/book/readaction-offer-category-allowed> a sh:NodeShape ;
    sh:message "The Offer category is nologinrequired, free, subscription, purchase or rental, compared case-insensitively (on the Offer under the expectsAcceptanceOf of a ReadAction under an Edition's potentialAction)." ;
    sh:or ( [ sh:not [ sh:property [ sh:minCount 1 ;
                                sh:path ( [ sh:inversePath schema:expectsAcceptanceOf ] [ sh:inversePath schema:potentialAction ] [ sh:inversePath schema:workExample ] ) ] ] ] [ sh:property [ sh:flags "i" ;
                        sh:path schema:category ;
                        sh:pattern "^(nologinrequired|free|subscription|purchase|rental)$" ] ] ) ;
    sh:targetObjectsOf schema:expectsAcceptanceOf .

<https://wordlift.io/shacl/google/book/readaction-offer-category-present> a sh:NodeShape ;
    sh:message "Every Offer has a category (on the Offer under the expectsAcceptanceOf of a ReadAction under an Edition's potentialAction)." ;
    sh:or ( [ sh:not [ sh:property [ sh:minCount 1 ;
                                sh:path ( [ sh:inversePath schema:expectsAcceptanceOf ] [ sh:inversePath schema:potentialAction ] [ sh:inversePath schema:workExample ] ) ] ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:category ] ] ) ;
    sh:targetObjectsOf schema:expectsAcceptanceOf .

<https://wordlift.io/shacl/google/book/readaction-offer-eligibleregion-present> a sh:NodeShape ;
    sh:message "Every Offer has an eligibleRegion (on the Offer under the expectsAcceptanceOf of a ReadAction under an Edition's potentialAction)." ;
    sh:or ( [ sh:not [ sh:property [ sh:minCount 1 ;
                                sh:path ( [ sh:inversePath schema:expectsAcceptanceOf ] [ sh:inversePath schema:potentialAction ] [ sh:inversePath schema:workExample ] ) ] ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:eligibleRegion ] ] ) ;
    sh:targetObjectsOf schema:expectsAcceptanceOf .

<https://wordlift.io/shacl/google/book/readaction-offer-price-required-for-purchase-rental> a sh:NodeShape ;
    sh:message "An Offer whose category is purchase or rental (case-insensitive) has a price (on the Offer under the expectsAcceptanceOf of a ReadAction under an Edition's potentialAction)." ;
    sh:or ( [ sh:not [ sh:property [ sh:minCount 1 ;
                                sh:path ( [ sh:inversePath schema:expectsAcceptanceOf ] [ sh:inversePath schema:potentialAction ] [ sh:inversePath schema:workExample ] ) ] ] ] [ sh:not [ sh:property [ sh:path schema:category ;
                                sh:qualifiedMinCount 1 ;
                                sh:qualifiedValueShape [ sh:flags "i" ;
                                        sh:pattern "^(purchase|rental)$" ] ] ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:price ] ] ) ;
    sh:targetObjectsOf schema:expectsAcceptanceOf .

<https://wordlift.io/shacl/google/book/readaction-offer-pricecurrency-present> a sh:NodeShape ;
    sh:message "Every Offer has a priceCurrency (on the Offer under the expectsAcceptanceOf of a ReadAction under an Edition's potentialAction)." ;
    sh:property [ sh:path ( schema:potentialAction schema:expectsAcceptanceOf ) ;
            sh:qualifiedMaxCount 0 ;
            sh:qualifiedValueShape [ sh:not [ sh:property [ sh:minCount 1 ;
                                    sh:path schema:priceCurrency ] ] ] ;
            sh:severity sh:Warning ] ;
    sh:targetObjectsOf schema:workExample .

<https://wordlift.io/shacl/google/book/readaction-target-present> a sh:NodeShape ;
    sh:message "Every ReadAction has a target (on the ReadAction under an Edition's potentialAction)." ;
    sh:or ( [ sh:not [ sh:property [ sh:minCount 1 ;
                                sh:path ( [ sh:inversePath schema:potentialAction ] [ sh:inversePath schema:workExample ] ) ] ] ] [ sh:not [ sh:class schema:ReadAction ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:target ] ] ) ;
    sh:targetObjectsOf schema:potentialAction .

