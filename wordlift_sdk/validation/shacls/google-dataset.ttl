<https://wordlift.io/shacl/google/dataset/datadownload-contenturl-required> a sh:NodeShape ;
    sh:message "Every DataDownload (including those under a Dataset's distribution) must have a contentUrl." ;
    sh:property [ sh:minCount 1 ;
            sh:path schema:contentUrl ] ;
    sh:targetClass schema:DataDownload .

<https://wordlift.io/shacl/google/dataset/datadownload-encodingformat-recommended> a sh:NodeShape ;
    sh:message "Every DataDownload should have an encodingFormat." ;
