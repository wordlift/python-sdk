@prefix : <https://wordlift.io/shacl/google/google-review-snippet/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix schema: <http://schema.org/> .

# Source: https://developers.google.com/search/docs/appearance/structured-data/review-snippet
# Generated: 2026-02-04T23:26:20Z
# Notes: required properties => errors; recommended properties => warnings.

:google_ReviewShape
  a sh:NodeShape ;
  sh:targetClass schema:Review ;
  sh:property [
    sh:path schema:author ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path schema:itemReviewed ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path ( schema:itemReviewed schema:name ) ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path schema:reviewRating ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path ( schema:reviewRating schema:ratingValue ) ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path schema:datePublished ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "Recommended by Google: datePublished." ;
  ] ;
  sh:property [
    sh:path ( schema:reviewRating schema:bestRating ) ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "Recommended by Google: reviewRating.bestRating." ;
  ] ;
  sh:property [
    sh:path ( schema:reviewRating schema:worstRating ) ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "Recommended by Google: reviewRating.worstRating." ;
  ] ;
.
