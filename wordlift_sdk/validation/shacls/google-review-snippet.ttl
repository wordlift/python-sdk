<https://wordlift.io/shacl/google/review-snippet/review-multiple-reviews-aggregaterating-required> a sh:NodeShape ;
    sh:message "Google review-snippet review-multiple-reviews-aggregaterating-required: a node with two or more Reviews should also have aggregateRating." ;
    sh:or ( [ sh:property [ sh:maxCount 1 ;
                        sh:path schema:review ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:aggregateRating ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetSubjectsOf schema:review .

<https://wordlift.io/shacl/google/review-snippet/review-nested-itemreviewed-omit> a sh:NodeShape ;
    sh:message "Google review-snippet review-nested-itemreviewed-omit: a nested Review should omit itemReviewed." ;
    sh:property [ sh:maxCount 0 ;
            sh:message "Google review-snippet review-nested-itemreviewed-omit: a nested Review should omit itemReviewed." ;
            sh:path schema:itemReviewed ;
            sh:severity sh:Warning ] ;
    sh:targetObjectsOf schema:review .

<https://wordlift.io/shacl/google/review-snippet/review-nested-parent-name-required> a sh:NodeShape ;
    sh:message "Google review-snippet review-nested-parent-name-required: the node holding a nested Review in its review property must have a name." ;
    sh:property [ sh:minCount 1 ;
            sh:path schema:name ] ;
    sh:targetSubjectsOf schema:review .

<https://wordlift.io/shacl/google/review-snippet/review-reviewrating-bestrating-recommended> a sh:NodeShape ;
    sh:message "Google review-snippet review-reviewrating-bestrating-recommended: the reviewRating should have bestRating." ;
    sh:or ( [ sh:class schema:ClaimReview ] [ sh:class schema:EmployerReview ] [ sh:property [ sh:node [ sh:property [ sh:minCount 1 ;
                                        sh:path schema:bestRating ] ] ;
                        sh:path schema:reviewRating ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetClass schema:ClaimReview,
        schema:CriticReview,
        schema:EmployerReview,
        schema:MediaReview,
        schema:Recommendation,
        schema:Review,
        schema:ReviewNewsArticle,
        schema:UserReview .

<https://wordlift.io/shacl/google/review-snippet/review-reviewrating-ratingvalue-required> a sh:NodeShape ;
    sh:message "Google review-snippet review-reviewrating-ratingvalue-required: the reviewRating of a Review must have ratingValue." ;
    sh:or ( [ sh:class schema:ClaimReview ] [ sh:class schema:EmployerReview ] [ sh:property [ sh:node [ sh:property [ sh:minCount 1 ;
                                        sh:path schema:ratingValue ] ] ;
                        sh:path schema:reviewRating ] ] ) ;
    sh:targetClass schema:ClaimReview,
        schema:CriticReview,
        schema:EmployerReview,
        schema:MediaReview,
        schema:Recommendation,
        schema:Review,
        schema:ReviewNewsArticle,
        schema:UserReview .

<https://wordlift.io/shacl/google/review-snippet/review-reviewrating-required> a sh:NodeShape ;
    sh:message "Google review-snippet review-reviewrating-required: a Review must have reviewRating unless it has both author and datePublished." ;
    sh:or ( [ sh:class schema:ClaimReview ] [ sh:class schema:EmployerReview ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:reviewRating ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:author ],
                    [ sh:minCount 1 ;
                        sh:path schema:datePublished ] ] ) ;
    sh:targetClass schema:ClaimReview,
        schema:CriticReview,
        schema:EmployerReview,
        schema:MediaReview,
        schema:Recommendation,
        schema:Review,
        schema:ReviewNewsArticle,
        schema:UserReview .

<https://wordlift.io/shacl/google/review-snippet/review-reviewrating-worstrating-recommended> a sh:NodeShape ;
    sh:message "Google review-snippet review-reviewrating-worstrating-recommended: the reviewRating should have worstRating." ;
    sh:or ( [ sh:class schema:ClaimReview ] [ sh:class schema:EmployerReview ] [ sh:property [ sh:node [ sh:property [ sh:minCount 1 ;
                                        sh:path schema:worstRating ] ] ;
                        sh:path schema:reviewRating ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetClass schema:ClaimReview,
        schema:CriticReview,
        schema:EmployerReview,
        schema:MediaReview,
        schema:Recommendation,
        schema:Review,
        schema:ReviewNewsArticle,
        schema:UserReview .

