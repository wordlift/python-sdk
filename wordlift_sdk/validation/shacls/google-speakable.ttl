<https://wordlift.io/shacl/google/speakable/speakable-spec-locator-required> a sh:NodeShape ;
    sh:property [ sh:message "Speakable specification must have at least one of cssSelector or xPath (speakable-spec-locator-required)." ;
            sh:node [ a sh:NodeShape ;
                    sh:message "Speakable specification must have at least one of cssSelector or xPath (speakable-spec-locator-required)." ;
                    sh:or ( [ sh:property [ sh:minCount 1 ;
                                        sh:path schema:cssSelector ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path schema:xPath ] ] ) ;
                    sh:severity sh:Violation ] ;
            sh:path schema:speakable ;
            sh:severity sh:Violation ] ;
