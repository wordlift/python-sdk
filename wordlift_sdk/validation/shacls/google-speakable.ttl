<https://wordlift.io/shacl/google/speakable/speakable-spec-locator-not-both> a sh:NodeShape ;
    sh:property [ sh:message "Speakable specification must not have both cssSelector and xPath (speakable-spec-locator-not-both)." ;
            sh:node [ a sh:NodeShape ;
                    sh:message "Speakable specification must not have both cssSelector and xPath (speakable-spec-locator-not-both)." ;
                    sh:not [ sh:and ( [ sh:property [ sh:minCount 1 ;
                                                sh:path schema:cssSelector ] ] [ sh:property [ sh:minCount 1 ;
                                                sh:path schema:xPath ] ] ) ] ;
                    sh:severity sh:Violation ] ;
            sh:path schema:speakable ;
            sh:severity sh:Violation ] ;
    sh:targetClass schema:APIReference,
        schema:AboutPage,
