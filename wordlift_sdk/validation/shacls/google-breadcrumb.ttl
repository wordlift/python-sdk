@prefix : <https://wordlift.io/shacl/google/google-breadcrumb/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix schema: <http://schema.org/> .

# Source: https://developers.google.com/search/docs/appearance/structured-data/breadcrumb
# Generated: 2026-09-09T08:57:24Z
# Notes: required properties => errors; recommended properties => warnings.

:google_BreadcrumbListShape
  a sh:NodeShape ;
  sh:targetClass schema:BreadcrumbList ;
  sh:property [
    sh:path schema:itemListElement ;
    sh:minCount 1 ;
    sh:node [
      a sh:NodeShape ;
      sh:class schema:ListItem ;
      sh:property [
        sh:path schema:position ;
        sh:minCount 1 ;
      ] ;
      sh:or (
        [
          sh:property [
            sh:path schema:name ;
            sh:minCount 1 ;
          ] ;
        ]
        [
          sh:property [
            sh:path schema:item ;
            sh:node [
              sh:property [
                sh:path schema:name ;
                sh:minCount 1 ;
              ] ;
            ] ;
          ] ;
        ]
      ) ;
    ] ;
  ] ;
  sh:property [
    sh:path schema:itemListElement ;
    sh:qualifiedValueShape [
      sh:not [
        sh:property [
          sh:path schema:item ;
          sh:minCount 1 ;
        ] ;
      ] ;
    ] ;
    sh:qualifiedMaxCount 1 ;
    sh:message "Required by Google: item on every ListItem except the final one." ;
  ] ;
.
