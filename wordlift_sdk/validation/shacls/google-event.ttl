      SELECT $this ?value WHERE {
        $this <http://schema.org/name> ?value .
        $this <http://schema.org/location> ?place .
        ?place <http://schema.org/name> ?value .
        FILTER NOT EXISTS { ?list <http://schema.org/item> $this }
