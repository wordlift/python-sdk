<https://wordlift.io/shacl/google/job-posting/jobposting-experienceinplaceofeducation-requires-both> a sh:NodeShape ;
    sh:message "A JobPosting with experienceInPlaceOfEducation true must have both experienceRequirements and educationRequirements." ;
    sh:or ( [ sh:not [ sh:property [ sh:hasValue true ;
                                sh:path schema:experienceInPlaceOfEducation ] ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:experienceRequirements ],
                    [ sh:minCount 1 ;
                        sh:path schema:educationRequirements ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetClass schema:JobPosting .

