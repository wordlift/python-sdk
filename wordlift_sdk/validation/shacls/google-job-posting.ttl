            sh:path schema:address ] ;
    sh:targetObjectsOf schema:jobLocation .

<https://wordlift.io/shacl/google/job-posting/jobposting-joblocation-missing> a sh:NodeShape ;
    sh:message "JobPosting must have a jobLocation, unless it has applicantLocationRequirements." ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
