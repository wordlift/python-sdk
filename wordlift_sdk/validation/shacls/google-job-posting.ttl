<https://wordlift.io/shacl/google/job-posting/jobposting-joblocation-addresscountry-missing> a sh:NodeShape ;
    sh:property [ sh:message "Each jobLocation Place must have an address PostalAddress with addressCountry." ;
            sh:minCount 1 ;
            sh:node [ sh:property [ sh:minCount 1 ;
