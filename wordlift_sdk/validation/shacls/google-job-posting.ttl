<https://wordlift.io/shacl/google/job-posting/jobposting-applicantlocationrequirements-missing> a sh:NodeShape ;
    sh:property [ sh:message "JobPosting should have applicantLocationRequirements." ;
            sh:minCount 1 ;
            sh:path schema:applicantLocationRequirements ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:JobPosting .

<https://wordlift.io/shacl/google/job-posting/jobposting-basesalary-missing> a sh:NodeShape ;
    sh:property [ sh:message "JobPosting should have baseSalary." ;
            sh:minCount 1 ;
            sh:path schema:baseSalary ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:JobPosting .

<https://wordlift.io/shacl/google/job-posting/jobposting-basesalary-unittext-invalid> a sh:NodeShape ;
    sh:property [ sh:in ( "HOUR" "DAY" "WEEK" "MONTH" "YEAR" ) ;
            sh:message "baseSalary unitText must be one of HOUR, DAY, WEEK, MONTH, YEAR (case-sensitive)." ;
            sh:path ( schema:baseSalary schema:value schema:unitText ) ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:JobPosting .

<https://wordlift.io/shacl/google/job-posting/jobposting-credentialcategory-invalid> a sh:NodeShape ;
    sh:property [ sh:in ( "high school" "associate degree" "bachelor degree" "professional certificate" "postgraduate degree" ) ;
            sh:message "credentialCategory must be one of: high school, associate degree, bachelor degree, professional certificate, postgraduate degree." ;
            sh:path schema:credentialCategory ;
            sh:severity sh:Warning ] ;
    sh:targetObjectsOf schema:educationRequirements .

<https://wordlift.io/shacl/google/job-posting/jobposting-credentialcategory-missing> a sh:NodeShape ;
    sh:message "EducationalOccupationalCredential under educationRequirements should have credentialCategory." ;
    sh:or ( [ sh:nodeKind sh:Literal ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:credentialCategory ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetObjectsOf schema:educationRequirements .

