<https://wordlift.io/shacl/google/article/article-author-missing> a sh:NodeShape ;
    sh:message "Article is missing an author (rule article-author-missing)." ;
    sh:or ( [ sh:and ( [ sh:or ( [ sh:class schema:SocialMediaPosting ] [ sh:class schema:BlogPosting ] [ sh:class schema:DiscussionForumPosting ] [ sh:class schema:LiveBlogPosting ] ) ] [ sh:not [ sh:or ( [ sh:class schema:BlogPosting ] [ sh:class schema:LiveBlogPosting ] ) ] ] ) ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:author ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetClass schema:APIReference,
        schema:AdvertiserContentArticle,
        schema:AnalysisNewsArticle,
        schema:Article,
        schema:AskPublicNewsArticle,
        schema:BackgroundNewsArticle,
        schema:BlogPosting,
        schema:DiscussionForumPosting,
        schema:LiveBlogPosting,
        schema:MedicalScholarlyArticle,
        schema:NewsArticle,
        schema:OpinionNewsArticle,
        schema:Report,
        schema:ReportageNewsArticle,
        schema:ReviewNewsArticle,
        schema:SatiricalArticle,
        schema:ScholarlyArticle,
        schema:SocialMediaPosting,
        schema:TechArticle .

<https://wordlift.io/shacl/google/article/article-author-name-missing> a sh:NodeShape ;
    sh:message "An author of the article has no name (rule article-author-name-missing)." ;
    sh:or ( [ sh:and ( [ sh:or ( [ sh:class schema:SocialMediaPosting ] [ sh:class schema:BlogPosting ] [ sh:class schema:DiscussionForumPosting ] [ sh:class schema:LiveBlogPosting ] ) ] [ sh:not [ sh:or ( [ sh:class schema:BlogPosting ] [ sh:class schema:LiveBlogPosting ] ) ] ] ) ] [ sh:property [ sh:path schema:author ;
