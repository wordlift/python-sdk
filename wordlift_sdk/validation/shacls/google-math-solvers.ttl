@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://wordlift.io/shacl/google/math-solvers/learningresource-learningresourcetype-missing> a sh:NodeShape ;
    sh:message "A MathSolver that is also a LearningResource must have a learningResourceType (Math Solver)." ;
    sh:or ( [ sh:not [ sh:or ( [ sh:class schema:LearningResource ] [ sh:class schema:Course ] [ sh:class schema:Quiz ] [ sh:class schema:Syllabus ] ) ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:learningResourceType ] ] ) ;
    sh:targetClass schema:MathSolver .

<https://wordlift.io/shacl/google/math-solvers/learningresource-learningresourcetype-value> a sh:NodeShape ;
    sh:message "learningResourceType on a MathSolver LearningResource must be 'Math Solver' (case-insensitive; an array passes if any item matches)." ;
    sh:or ( [ sh:not [ sh:or ( [ sh:class schema:LearningResource ] [ sh:class schema:Course ] [ sh:class schema:Quiz ] [ sh:class schema:Syllabus ] ) ] ] [ sh:not [ sh:property [ sh:minCount 1 ;
                                sh:path schema:learningResourceType ] ] ] [ sh:property [ sh:path schema:learningResourceType ;
                        sh:qualifiedMinCount 1 ;
                        sh:qualifiedValueShape [ sh:flags "i" ;
                                sh:pattern "^math solver$" ] ] ] ) ;
    sh:targetClass schema:MathSolver .

<https://wordlift.io/shacl/google/math-solvers/mathsolver-assesses-missing-with-howto> a sh:NodeShape ;
    sh:message "MathSolver should have assesses when the same document also contains HowTo markup." ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:select """
      SELECT $this WHERE {
        $this a <http://schema.org/MathSolver> .
        ?howto a <http://schema.org/HowTo> .
        FILTER NOT EXISTS { $this <http://schema.org/assesses> ?topic . }
      }
    """ ] ;
    sh:targetClass schema:MathSolver .

<https://wordlift.io/shacl/google/math-solvers/mathsolver-inlanguage-missing> a sh:NodeShape ;
    sh:property [ sh:message "MathSolver should have an inLanguage." ;
            sh:minCount 1 ;
            sh:path schema:inLanguage ;
