<https://wordlift.io/shacl/google/video/video-haspart-clip-startoffset-unique> a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Two Clips under the same video's hasPart must not share a startOffset." ;
            sh:select """
            SELECT $this ?value WHERE {
                $this <http://schema.org/hasPart> ?c1 .
                ?c1 a <http://schema.org/Clip> ; <http://schema.org/startOffset> ?value .
                $this <http://schema.org/hasPart> ?c2 .
                ?c2 a <http://schema.org/Clip> ; <http://schema.org/startOffset> ?value .
                FILTER (?c1 != ?c2)
            }
        """ ] ;
    sh:targetClass schema:VideoObject,
        schema:VideoObjectSnapshot .

