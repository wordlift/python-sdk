<https://wordlift.io/shacl/google/video/video-duration-min-30s-with-clip-or-seektoaction> a sh:NodeShape ;
    sh:message "A video with a Clip or SeekToAction must have a duration of at least 30 seconds." ;
    sh:or ( [ sh:property [ sh:maxCount 0 ;
                        sh:path schema:duration ] ] [ sh:not [ sh:or ( [ sh:property [ sh:path schema:hasPart ;
                                            sh:qualifiedMinCount 1 ;
                                            sh:qualifiedValueShape [ sh:or ( [ sh:class schema:Clip ] [ sh:class schema:MovieClip ] [ sh:class schema:RadioClip ] [ sh:class schema:TVClip ] [ sh:class schema:VideoGameClip ] ) ] ] ] [ sh:property [ sh:path schema:potentialAction ;
                                            sh:qualifiedMinCount 1 ;
                                            sh:qualifiedValueShape [ sh:class schema:SeekToAction ] ] ] ) ] ] [ sh:property [ sh:message "Duration is under 30 seconds on a video with a Clip or SeekToAction." ;
                        sh:not [ sh:pattern "^PT(?:0*M)?(?:0*(?:[0-9]|[12][0-9])(?:\\.[0-9]+)?S)?$" ] ;
                        sh:path schema:duration ] ] ) ;
    sh:targetClass schema:VideoObject,
        schema:VideoObjectSnapshot .

