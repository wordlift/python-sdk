<https://wordlift.io/shacl/google/shipping-policy/definedregion-addressregion-recommended> a sh:NodeShape ;
    sh:message "A DefinedRegion for US, AU or JP should have addressRegion." ;
    sh:or ( [ sh:not [ sh:property [ sh:in ( "US" "AU" "JP" ) ;
