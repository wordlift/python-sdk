<https://wordlift.io/shacl/google/shipping-policy/handlingduration-minvalue-recommended> a sh:NodeShape ;
    sh:message "The handling time duration should have minValue (unless it uses value)." ;
    sh:or ( [ sh:property [ sh:maxCount 0 ;
                        sh:path ( schema:handlingTime schema:duration ) ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path ( schema:handlingTime schema:duration schema:value ) ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path ( schema:handlingTime schema:duration schema:minValue ) ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetClass schema:ShippingService .

<https://wordlift.io/shacl/google/shipping-policy/handlingduration-nonnegative-integer> a sh:NodeShape ;
    sh:property [ sh:message "The handling time duration minValue should be a non-negative whole number." ;
            sh:path ( schema:handlingTime schema:duration schema:minValue ) ;
