        schema:VeterinaryCare,
        schema:WholesaleStore,
        schema:Winery,
        schema:WorkersUnion .

<https://wordlift.io/shacl/google/shipping-policy/shippingservice-name-recommended> a sh:NodeShape ;
    sh:property [ sh:message "A ShippingService should have a name." ;
            sh:minCount 1 ;
            sh:path schema:name ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:ShippingService .

<https://wordlift.io/shacl/google/shipping-policy/shippingservice-shippingconditions-required> a sh:NodeShape ;
    sh:property [ sh:message "A ShippingService must have shippingConditions." ;
            sh:minCount 1 ;
            sh:path schema:shippingConditions ] ;
    sh:targetClass schema:ShippingService .

<https://wordlift.io/shacl/google/shipping-policy/transitduration-minvalue-recommended> a sh:NodeShape ;
    sh:message "The transit time duration should have minValue (unless it uses value)." ;
    sh:or ( [ sh:property [ sh:maxCount 0 ;
                        sh:path ( schema:transitTime schema:duration ) ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path ( schema:transitTime schema:duration schema:value ) ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path ( schema:transitTime schema:duration schema:minValue ) ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetObjectsOf schema:shippingConditions .

<https://wordlift.io/shacl/google/shipping-policy/transitduration-nonnegative-integer> a sh:NodeShape ;
    sh:property [ sh:message "The transit time duration minValue should be a non-negative whole number." ;
            sh:path ( schema:transitTime schema:duration schema:minValue ) ;
            sh:pattern "^[0-9]+$" ;
            sh:severity sh:Warning ],
        [ sh:message "The transit time duration maxValue should be a non-negative whole number." ;
            sh:path ( schema:transitTime schema:duration schema:maxValue ) ;
            sh:pattern "^[0-9]+$" ;
            sh:severity sh:Warning ],
        [ sh:message "The transit time duration value should be a non-negative whole number." ;
            sh:path ( schema:transitTime schema:duration schema:value ) ;
            sh:pattern "^[0-9]+$" ;
            sh:severity sh:Warning ] ;
    sh:targetObjectsOf schema:shippingConditions .

<https://wordlift.io/shacl/google/shipping-policy/transitduration-unitcode-day> a sh:NodeShape ;
    sh:property [ sh:in ( "DAY" "d" ) ;
            sh:message "The transit time duration unitCode should be DAY or d." ;
            sh:path ( schema:transitTime schema:duration schema:unitCode ) ;
            sh:severity sh:Warning ] ;
    sh:targetObjectsOf schema:shippingConditions .

<https://wordlift.io/shacl/google/shipping-policy/transitduration-unitcode-required> a sh:NodeShape ;
    sh:property [ sh:path schema:transitTime ;
            sh:property [ sh:path schema:duration ;
                    sh:property [ sh:message "The transit time duration should have unitCode." ;
                            sh:minCount 1 ;
                            sh:path schema:unitCode ;
                            sh:severity sh:Warning ] ] ] ;
    sh:targetObjectsOf schema:shippingConditions .

<https://wordlift.io/shacl/google/shipping-policy/transitduration-value-excludes-minmax> a sh:NodeShape ;
    sh:property [ sh:message "When the transit time duration has value, minValue and maxValue must not be given." ;
            sh:or ( [ sh:property [ sh:maxCount 0 ;
                                sh:path schema:value ] ] [ sh:and ( [ sh:property [ sh:maxCount 0 ;
                                            sh:path schema:minValue ] ] [ sh:property [ sh:maxCount 0 ;
                                            sh:path schema:maxValue ] ] ) ] ) ;
            sh:path ( schema:transitTime schema:duration ) ;
            sh:severity sh:Warning ] ;
    sh:targetObjectsOf schema:shippingConditions .

<https://wordlift.io/shacl/google/shipping-policy/transitduration-value-or-maxvalue> a sh:NodeShape ;
    sh:property [ sh:message "The transit time duration should have value or maxValue." ;
            sh:or ( [ sh:property [ sh:minCount 1 ;
                                sh:path schema:value ] ] [ sh:property [ sh:minCount 1 ;
                                sh:path schema:maxValue ] ] ) ;
            sh:path ( schema:transitTime schema:duration ) ;
            sh:severity sh:Warning ] ;
    sh:targetObjectsOf schema:shippingConditions .

<https://wordlift.io/shacl/google/shipping-policy/transittime-businessdays-recommended> a sh:NodeShape ;
    sh:property [ sh:path schema:transitTime ;
            sh:property [ sh:message "The transit time should have businessDays." ;
                    sh:minCount 1 ;
                    sh:path schema:businessDays ;
                    sh:severity sh:Warning ] ] ;
    sh:targetObjectsOf schema:shippingConditions .

<https://wordlift.io/shacl/google/shipping-policy/transittime-duration-recommended> a sh:NodeShape ;
    sh:property [ sh:path schema:transitTime ;
            sh:property [ sh:message "The transit time should have duration." ;
                    sh:minCount 1 ;
                    sh:path schema:duration ;
                    sh:severity sh:Warning ] ] ;
    sh:targetObjectsOf schema:shippingConditions .

