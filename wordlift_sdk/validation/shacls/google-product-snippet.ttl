@prefix : <https://wordlift.io/shacl/google/google-product-snippet/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix schema: <http://schema.org/> .

# Source: https://developers.google.com/search/docs/appearance/structured-data/product-snippet
# Generated: 2026-02-26T12:53:00Z
# Notes: required properties => errors; recommended properties => warnings.

:google_ProductShape
  a sh:NodeShape ;
  sh:targetClass schema:Product ;
  sh:property [
    sh:path schema:name ;
    sh:minCount 1 ;
  ] ;
  sh:or (
    [
      sh:property [
        sh:path schema:aggregateRating ;
        sh:minCount 1 ;
      ] ;
    ]
    [
      sh:property [
        sh:path schema:offers ;
        sh:minCount 1 ;
          sh:or (
            [
              a sh:NodeShape ;
              sh:class schema:Offer ;
              sh:property [
                sh:path schema:availability ;
                sh:minCount 1 ;
                sh:severity sh:Warning ;
                sh:message "Recommended by Google: availability." ;
              ] ;
              sh:property [
                sh:path schema:priceValidUntil ;
                sh:minCount 1 ;
                sh:severity sh:Warning ;
                sh:message "Recommended by Google: priceValidUntil." ;
              ] ;
              sh:or (
                [
                  sh:property [
                    sh:path schema:price ;
                    sh:minCount 1 ;
                  ] ;
                ]
                [
                  sh:property [
                    sh:path ( schema:priceSpecification schema:price ) ;
                    sh:minCount 1 ;
                  ] ;
                ]
              ) ;
              sh:or (
                [
                  sh:property [
                    sh:path schema:priceCurrency ;
                    sh:minCount 1 ;
                  ] ;
                ]
                [
                  sh:property [
                    sh:path ( schema:priceSpecification schema:priceCurrency ) ;
                    sh:minCount 1 ;
                  ] ;
                ]
              ) ;
            ]
            [
              a sh:NodeShape ;
              sh:class schema:AggregateOffer ;
              sh:property [
                sh:path schema:lowPrice ;
                sh:minCount 1 ;
              ] ;
              sh:property [
                sh:path schema:priceCurrency ;
                sh:minCount 1 ;
              ] ;
              sh:property [
                sh:path schema:highPrice ;
                sh:minCount 1 ;
                sh:severity sh:Warning ;
                sh:message "Recommended by Google: highPrice." ;
              ] ;
              sh:property [
                sh:path schema:offerCount ;
                sh:minCount 1 ;
                sh:severity sh:Warning ;
                sh:message "Recommended by Google: offerCount." ;
              ] ;
            ]
          ) ;
      ] ;
    ]
    [
      sh:property [
        sh:path schema:review ;
        sh:minCount 1 ;
          sh:node [
            a sh:NodeShape ;
            sh:class schema:Review ;
            sh:or (
              [
                sh:property [
                  sh:path schema:negativeNotes ;
                  sh:minCount 1 ;
                    sh:node [
                      a sh:NodeShape ;
                      sh:class schema:ItemList ;
                      sh:property [
                        sh:path schema:itemListElement ;
                        sh:minCount 1 ;
                      ] ;
                      sh:property [
                        sh:path ( schema:itemListElement schema:name ) ;
                        sh:minCount 1 ;
                      ] ;
                      sh:property [
                        sh:path ( schema:itemListElement schema:position ) ;
                        sh:minCount 1 ;
                        sh:severity sh:Warning ;
                        sh:message "Recommended by Google: itemListElement.position." ;
                      ] ;
                    ] ;
                ] ;
              ]
              [
                sh:property [
                  sh:path schema:positiveNotes ;
                  sh:minCount 1 ;
                    sh:node [
                      a sh:NodeShape ;
                      sh:class schema:ItemList ;
                      sh:property [
                        sh:path schema:itemListElement ;
                        sh:minCount 1 ;
                      ] ;
                      sh:property [
                        sh:path ( schema:itemListElement schema:name ) ;
                        sh:minCount 1 ;
                      ] ;
                      sh:property [
                        sh:path ( schema:itemListElement schema:position ) ;
                        sh:minCount 1 ;
                        sh:severity sh:Warning ;
                        sh:message "Recommended by Google: itemListElement.position." ;
                      ] ;
                    ] ;
                ] ;
              ]
            ) ;
          ] ;
      ] ;
    ]
  ) ;
.

:google_UnitPriceSpecificationShape
  a sh:NodeShape ;
  sh:targetClass schema:UnitPriceSpecification ;
  sh:property [
    sh:path schema:price ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path schema:priceCurrency ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "Recommended by Google: priceCurrency." ;
  ] ;
.
