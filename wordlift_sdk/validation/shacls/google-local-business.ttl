<https://wordlift.io/shacl/google/local-business/restaurant-carousel-address-recommended> a sh:NodeShape ;
    sh:message "A Restaurant that is an item of a restaurant carousel (ItemList) should have address." ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path schema:address ] ] [ sh:property [ sh:maxCount 0 ;
                        sh:path ( [ sh:inversePath schema:item ] [ sh:inversePath schema:itemListElement ] ) ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetClass schema:Restaurant .

