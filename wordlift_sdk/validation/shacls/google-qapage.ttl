            sh:path [ sh:alternativePath ( ( schema:mainEntity schema:comment ) ( schema:mainEntity [ sh:alternativePath ( schema:acceptedAnswer schema:suggestedAnswer ) ] schema:comment ) ) ] ;
            sh:qualifiedMaxCount 0 ;
            sh:qualifiedValueShape [ sh:not [ sh:property [ sh:minCount 1 ;
                                    sh:path schema:video ] ] ;
                    sh:or ( [ sh:class schema:Comment ] [ sh:class schema:Answer ] [ sh:class schema:CorrectionComment ] [ sh:class schema:Question ] ) ] ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:QAPage .

