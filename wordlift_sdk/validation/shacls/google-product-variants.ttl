    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "productgroup-productgroupid-matches-variants: a variant inProductGroupWithID must equal the ProductGroup productGroupID." ;
            sh:select """
SELECT $this ?v WHERE {
  $this <http://schema.org/productGroupID> ?p .
  { $this <http://schema.org/hasVariant> ?v } UNION { ?v <http://schema.org/isVariantOf> $this }
