# Source: https://developers.google.com/search/docs/appearance/structured-data/factcheck
# Generated: 2026-11-05T14:35:24Z
# Notes: required properties => errors; recommended properties => warnings.
# google-factcheck: 18 rules generated from the Google Search Central doc by the tdd-mvp-3 pipeline.
# Bundled from per-rule files by harness/bundle.py, schema.org subtypes expanded (targetClass 0, class 0, in 0). Do not edit by hand.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://wordlift.io/shacl/google/factcheck/claim-appearance-or-firstappearance-recommended> a sh:NodeShape ;
    sh:property [ sh:message "Claim should have appearance or firstAppearance (you don't need both)." ;
            sh:minCount 1 ;
            sh:path [ sh:alternativePath ( schema:appearance schema:firstAppearance ) ] ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:Claim .

<https://wordlift.io/shacl/google/factcheck/claim-author-name-required> a sh:NodeShape ;
    sh:property [ sh:message "When a Claim has an author, the author must have name." ;
            sh:path schema:author ;
            sh:qualifiedMaxCount 0 ;
            sh:qualifiedValueShape [ sh:property [ sh:maxCount 0 ;
                            sh:path schema:name ] ] ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:Claim .

<https://wordlift.io/shacl/google/factcheck/claim-author-recommended> a sh:NodeShape ;
    sh:property [ sh:message "Claim should have author (the party making the claim, not the author of the fact check)." ;
            sh:minCount 1 ;
            sh:path schema:author ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:Claim .

<https://wordlift.io/shacl/google/factcheck/claim-author-sameas-recommended> a sh:NodeShape ;
    sh:property [ sh:message "When a Claim has an author, the author should have sameAs." ;
            sh:path schema:author ;
            sh:qualifiedMaxCount 0 ;
            sh:qualifiedValueShape [ sh:property [ sh:maxCount 0 ;
                            sh:path schema:sameAs ] ] ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:Claim .

<https://wordlift.io/shacl/google/factcheck/claim-datepublished-recommended> a sh:NodeShape ;
    sh:property [ sh:message "Claim should have datePublished (when the claim was made or entered public discourse)." ;
            sh:minCount 1 ;
            sh:path schema:datePublished ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:Claim .

<https://wordlift.io/shacl/google/factcheck/claimreview-author-name-or-url> a sh:NodeShape ;
    sh:property [ sh:message "The ClaimReview author must have at least one of name or url." ;
            sh:path schema:author ;
            sh:qualifiedMaxCount 0 ;
            sh:qualifiedValueShape [ sh:property [ sh:maxCount 0 ;
                            sh:path schema:name ],
                        [ sh:maxCount 0 ;
                            sh:path schema:url ] ] ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:ClaimReview .

<https://wordlift.io/shacl/google/factcheck/claimreview-author-recommended> a sh:NodeShape ;
    sh:property [ sh:message "ClaimReview should have author (the publisher of the fact-check article, not the publisher of the claim)." ;
            sh:minCount 1 ;
            sh:path schema:author ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:ClaimReview .

<https://wordlift.io/shacl/google/factcheck/claimreview-claimreviewed-required> a sh:NodeShape ;
    sh:property [ sh:message "ClaimReview must have claimReviewed (a short summary of the claim being evaluated)." ;
            sh:minCount 1 ;
            sh:path schema:claimReviewed ;
            sh:severity sh:Violation ] ;
    sh:targetClass schema:ClaimReview .

<https://wordlift.io/shacl/google/factcheck/claimreview-itemreviewed-recommended> a sh:NodeShape ;
    sh:property [ sh:message "ClaimReview should have itemReviewed (an object describing the claim being made)." ;
            sh:minCount 1 ;
            sh:path schema:itemReviewed ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:ClaimReview .

<https://wordlift.io/shacl/google/factcheck/claimreview-reviewrating-required> a sh:NodeShape ;
    sh:property [ sh:message "ClaimReview must have reviewRating (the assessment of the claim)." ;
            sh:minCount 1 ;
            sh:path schema:reviewRating ;
            sh:severity sh:Violation ] ;
    sh:targetClass schema:ClaimReview .

<https://wordlift.io/shacl/google/factcheck/claimreview-url-required> a sh:NodeShape ;
    sh:property [ sh:message "ClaimReview must have url (link to the page hosting the full fact-check article)." ;
            sh:minCount 1 ;
            sh:path schema:url ;
            sh:severity sh:Violation ] ;
    sh:targetClass schema:ClaimReview .

<https://wordlift.io/shacl/google/factcheck/rating-alternatename-required> a sh:NodeShape ;
    sh:property [ sh:message "The reviewRating of a ClaimReview must have alternateName (name is accepted as the fallback)." ;
            sh:node [ a sh:NodeShape ;
                    sh:or ( [ sh:property [ sh:minCount 1 ;
                                        sh:path schema:alternateName ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path schema:name ] ] ) ] ;
            sh:path schema:reviewRating ;
            sh:severity sh:Violation ] ;
    sh:targetClass schema:ClaimReview .

<https://wordlift.io/shacl/google/factcheck/rating-bestrating-gt-worstrating> a sh:NodeShape ;
    sh:property [ sh:message "The reviewRating of a ClaimReview must have bestRating greater than worstRating." ;
            sh:path schema:reviewRating ;
            sh:qualifiedMaxCount 0 ;
            sh:qualifiedValueShape [ sh:not [ sh:property [ sh:lessThan schema:bestRating ;
                                    sh:path schema:worstRating ] ] ] ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:ClaimReview .

<https://wordlift.io/shacl/google/factcheck/rating-bestrating-recommended> a sh:NodeShape ;
    sh:property [ sh:message "The reviewRating of a ClaimReview should have bestRating (the best value of the scale)." ;
            sh:path schema:reviewRating ;
            sh:qualifiedMaxCount 0 ;
            sh:qualifiedValueShape [ sh:property [ sh:maxCount 0 ;
                            sh:path schema:bestRating ] ] ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:ClaimReview .

<https://wordlift.io/shacl/google/factcheck/rating-ratingvalue-in-range> a sh:NodeShape ;
    sh:property [ sh:message "The reviewRating ratingValue of a ClaimReview must be between worstRating and bestRating inclusive." ;
            sh:path schema:reviewRating ;
            sh:qualifiedMaxCount 0 ;
            sh:qualifiedValueShape [ sh:not [ sh:property [ sh:lessThanOrEquals schema:bestRating ;
                                    sh:path schema:ratingValue ],
                                [ sh:lessThanOrEquals schema:ratingValue ;
                                    sh:path schema:worstRating ] ] ] ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:ClaimReview .

<https://wordlift.io/shacl/google/factcheck/rating-ratingvalue-recommended> a sh:NodeShape ;
    sh:property [ sh:message "The reviewRating of a ClaimReview should have ratingValue (a numeric rating of the claim)." ;
            sh:path schema:reviewRating ;
            sh:qualifiedMaxCount 0 ;
            sh:qualifiedValueShape [ sh:property [ sh:maxCount 0 ;
                            sh:path schema:ratingValue ] ] ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:ClaimReview .

<https://wordlift.io/shacl/google/factcheck/rating-worstrating-min> a sh:NodeShape ;
    sh:property [ sh:message "The reviewRating worstRating of a ClaimReview must have a minimum value of 1." ;
            sh:minInclusive 1 ;
            sh:path ( schema:reviewRating schema:worstRating ) ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:ClaimReview .

<https://wordlift.io/shacl/google/factcheck/rating-worstrating-recommended> a sh:NodeShape ;
    sh:property [ sh:message "The reviewRating of a ClaimReview should have worstRating (the worst value of the scale)." ;
            sh:path schema:reviewRating ;
            sh:qualifiedMaxCount 0 ;
            sh:qualifiedValueShape [ sh:property [ sh:maxCount 0 ;
                            sh:path schema:worstRating ] ] ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:ClaimReview .

