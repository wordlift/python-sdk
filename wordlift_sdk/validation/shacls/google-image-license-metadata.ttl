@prefix : <https://wordlift.io/shacl/google/google-image-license-metadata/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix schema: <http://schema.org/> .

# Source: https://developers.google.com/search/docs/appearance/structured-data/image-license-metadata
# Generated: 2026-02-25T16:11:59Z
# Notes: required properties => errors; recommended properties => warnings.

:google_ImageObjectShape
  a sh:NodeShape ;
  sh:targetClass schema:ImageObject ;
  sh:property [
    sh:path schema:contentUrl ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path schema:acquireLicensePage ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "Recommended by Google: acquireLicensePage." ;
  ] ;
  sh:property [
    sh:path ( schema:creator schema:name ) ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "Recommended by Google: creator.name." ;
  ] ;
  sh:or (
    [
      sh:property [
        sh:path schema:copyrightNotice ;
        sh:minCount 1 ;
      ] ;
    ]
    [
      sh:property [
        sh:path schema:creator ;
        sh:minCount 1 ;
      ] ;
    ]
    [
      sh:property [
        sh:path schema:creditText ;
        sh:minCount 1 ;
      ] ;
    ]
    [
      sh:property [
        sh:path schema:license ;
        sh:minCount 1 ;
      ] ;
    ]
  ) ;
.

:google_PersonShape
  a sh:NodeShape ;
  sh:targetClass schema:Person ;
  sh:property [
    sh:path schema:contentUrl ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path schema:acquireLicensePage ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "Recommended by Google: acquireLicensePage." ;
  ] ;
  sh:property [
    sh:path ( schema:creator schema:name ) ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "Recommended by Google: creator.name." ;
  ] ;
  sh:or (
    [
      sh:property [
        sh:path schema:copyrightNotice ;
        sh:minCount 1 ;
      ] ;
    ]
    [
      sh:property [
        sh:path schema:creator ;
        sh:minCount 1 ;
      ] ;
    ]
    [
      sh:property [
        sh:path schema:creditText ;
        sh:minCount 1 ;
      ] ;
    ]
    [
      sh:property [
        sh:path schema:license ;
        sh:minCount 1 ;
      ] ;
    ]
  ) ;
.
