# google-recipe: 23 rules generated from the Google Search Central doc by the tdd-mvp-3 pipeline.
# Bundled from per-rule files by harness/bundle.py, schema.org subtypes expanded (targetClass 0, class 2, in 0). Do not edit by hand.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://wordlift.io/shacl/google/recipe/howtodirection-text-missing> a sh:NodeShape ;
    sh:property [ sh:message "HowToDirection or HowToTip is missing text." ;
            sh:minCount 1 ;
            sh:path schema:text ] ;
    sh:targetClass schema:HowToDirection,
        schema:HowToTip .

<https://wordlift.io/shacl/google/recipe/howtosection-itemlistelement-missing> a sh:NodeShape ;
    sh:property [ sh:message "HowToSection is missing itemListElement (its steps)." ;
            sh:minCount 1 ;
            sh:path schema:itemListElement ] ;
    sh:targetClass schema:HowToSection .

<https://wordlift.io/shacl/google/recipe/howtosection-name-missing> a sh:NodeShape ;
    sh:property [ sh:message "HowToSection is missing a name." ;
            sh:minCount 1 ;
            sh:path schema:name ] ;
    sh:targetClass schema:HowToSection .

<https://wordlift.io/shacl/google/recipe/howtostep-text-or-itemlistelement-missing> a sh:NodeShape ;
    sh:message "HowToStep needs text or itemListElement." ;
    sh:or ( [ sh:not [ sh:class schema:HowToStep ] ] [ sh:not [ sh:or ( [ sh:property [ sh:minCount 1 ;
                                            sh:path [ sh:inversePath schema:recipeInstructions ] ] ] [ sh:property [ sh:minCount 1 ;
                                            sh:path [ sh:inversePath schema:step ] ] ] [ sh:property [ sh:path [ sh:inversePath schema:itemListElement ] ;
                                            sh:qualifiedMinCount 1 ;
                                            sh:qualifiedValueShape [ sh:class schema:HowToSection ] ] ] ) ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:text ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:itemListElement ] ] ) ;
    sh:targetObjectsOf schema:itemListElement,
        schema:recipeInstructions,
        schema:step .

<https://wordlift.io/shacl/google/recipe/listitem-position-missing> a sh:NodeShape ;
    sh:message "ListItem in a recipe list is missing position." ;
    sh:or ( [ sh:not [ sh:or ( [ sh:class schema:ListItem ] [ sh:class schema:HowToDirection ] [ sh:class schema:HowToItem ] [ sh:class schema:HowToSection ] [ sh:class schema:HowToStep ] [ sh:class schema:HowToSupply ] [ sh:class schema:HowToTip ] [ sh:class schema:HowToTool ] ) ] ] [ sh:not [ sh:property [ sh:path ( [ sh:inversePath schema:itemListElement ] schema:itemListElement schema:item ) ;
                                sh:qualifiedMinCount 1 ;
                                sh:qualifiedValueShape [ sh:class schema:Recipe ] ] ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:position ] ] ) ;
    sh:targetObjectsOf schema:itemListElement .

<https://wordlift.io/shacl/google/recipe/listitem-url-duplicate> a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Two ListItems in a recipe list share the same url." ;
            sh:select """
SELECT $this WHERE {
  ?li1 <http://schema.org/item> $this ; <http://schema.org/url> ?u .
  ?list <http://schema.org/itemListElement> ?li1 , ?li2 .
  ?li2 <http://schema.org/url> ?u .
  FILTER(?li1 != ?li2)
}
""" ] ;
    sh:targetClass schema:Recipe .

<https://wordlift.io/shacl/google/recipe/listitem-url-missing> a sh:NodeShape ;
    sh:message "ListItem in a recipe list is missing url." ;
    sh:or ( [ sh:not [ sh:or ( [ sh:class schema:ListItem ] [ sh:class schema:HowToDirection ] [ sh:class schema:HowToItem ] [ sh:class schema:HowToSection ] [ sh:class schema:HowToStep ] [ sh:class schema:HowToSupply ] [ sh:class schema:HowToTip ] [ sh:class schema:HowToTool ] ) ] ] [ sh:not [ sh:property [ sh:path ( [ sh:inversePath schema:itemListElement ] schema:itemListElement schema:item ) ;
                                sh:qualifiedMinCount 1 ;
                                sh:qualifiedValueShape [ sh:class schema:Recipe ] ] ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:url ] ] ) ;
    sh:targetObjectsOf schema:itemListElement .

<https://wordlift.io/shacl/google/recipe/recipe-aggregaterating-missing> a sh:NodeShape ;
    sh:property [ sh:message "Recipe is missing aggregateRating." ;
            sh:minCount 1 ;
            sh:path schema:aggregateRating ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:Recipe .

