<https://wordlift.io/shacl/google/recipe/recipe-time-missing> a sh:NodeShape ;
    sh:message "Recipe is missing totalTime, or cookTime and prepTime together." ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path schema:totalTime ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:cookTime ],
                    [ sh:minCount 1 ;
                        sh:path schema:prepTime ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetClass schema:Recipe .

