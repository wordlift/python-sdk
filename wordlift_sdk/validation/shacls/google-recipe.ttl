<https://wordlift.io/shacl/google/recipe/recipe-nutrition-calories-missing> a sh:NodeShape ;
    sh:property [ sh:message "Recipe is missing nutrition with calories." ;
            sh:minCount 1 ;
            sh:path ( schema:nutrition schema:calories ) ;
            sh:severity sh:Warning ] ;
    sh:targetClass schema:Recipe .

<https://wordlift.io/shacl/google/recipe/recipe-nutrition-calories-requires-recipeyield> a sh:NodeShape ;
    sh:message "Recipe has nutrition calories but no recipeYield (number of servings)." ;
    sh:or ( [ sh:property [ sh:maxCount 0 ;
                        sh:path ( schema:nutrition schema:calories ) ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schema:recipeYield ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetClass schema:Recipe .

